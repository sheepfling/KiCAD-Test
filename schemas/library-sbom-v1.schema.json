{
  "$defs": {
    "LibraryRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "licensing_path": {
          "minLength": 1,
          "title": "Licensing Path",
          "type": "string"
        },
        "licensing_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Licensing Sha256",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "provenance_path": {
          "minLength": 1,
          "title": "Provenance Path",
          "type": "string"
        },
        "provenance_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provenance Sha256",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "owner",
        "status",
        "provenance_path",
        "provenance_sha256",
        "licensing_path",
        "licensing_sha256"
      ],
      "title": "LibraryRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build_authorized": {
      "const": false,
      "default": false,
      "title": "Build Authorized",
      "type": "boolean"
    },
    "libraries": {
      "items": {
        "$ref": "#/$defs/LibraryRecord"
      },
      "title": "Libraries",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "libraries"
  ],
  "title": "LibrarySbom",
  "type": "object"
}
