{
  "$defs": {
    "Assembly": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssemblyKind"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/AssemblyMember"
          },
          "title": "Members",
          "type": "array"
        },
        "project_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "purchase_part": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchase Part"
        },
        "revision": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "kind",
        "members"
      ],
      "title": "Assembly",
      "type": "object"
    },
    "AssemblyKind": {
      "enum": [
        "purchased",
        "built",
        "phantom"
      ],
      "title": "AssemblyKind",
      "type": "string"
    },
    "AssemblyMember": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Item",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "ref": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "item",
        "quantity"
      ],
      "title": "AssemblyMember",
      "type": "object"
    },
    "Assurance": {
      "enum": [
        "unknown",
        "assumed",
        "inferred",
        "observed",
        "manufacturer_documented",
        "verified",
        "not_applicable"
      ],
      "title": "Assurance",
      "type": "string"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "assurance": {
          "$ref": "#/$defs/Assurance"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "from": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "From",
          "type": "string"
        },
        "harness": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConnectionKind"
        },
        "to": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "To",
          "type": "string"
        },
        "variants": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "variants",
        "assurance",
        "evidence"
      ],
      "title": "Connection",
      "type": "object"
    },
    "ConnectionKind": {
      "enum": [
        "electrical",
        "functional",
        "mechanical",
        "protocol"
      ],
      "title": "ConnectionKind",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Claims",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "claims"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "design_note",
        "observation",
        "datasheet",
        "test_report"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Harness": {
      "additionalProperties": false,
      "properties": {
        "assurance": {
          "$ref": "#/$defs/Assurance"
        },
        "conductor_area_mm2": {
          "exclusiveMinimum": 0,
          "title": "Conductor Area Mm2",
          "type": "number"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "instance": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Instance",
          "type": "string"
        },
        "length_mm": {
          "exclusiveMinimum": 0,
          "title": "Length Mm",
          "type": "number"
        },
        "revision": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "instance",
        "length_mm",
        "conductor_area_mm2",
        "assurance",
        "evidence"
      ],
      "title": "Harness",
      "type": "object"
    },
    "MechanicalHandoff": {
      "additionalProperties": false,
      "properties": {
        "assurance": {
          "$ref": "#/$defs/Assurance"
        },
        "datum": {
          "minLength": 1,
          "title": "Datum",
          "type": "string"
        },
        "drawing": {
          "minLength": 1,
          "title": "Drawing",
          "type": "string"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "instances": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
            "type": "string"
          },
          "title": "Instances",
          "type": "array"
        },
        "open_items": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Open Items",
          "type": "array"
        },
        "units": {
          "const": "mm",
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "id",
        "instances",
        "units",
        "datum",
        "drawing",
        "assurance",
        "evidence",
        "open_items"
      ],
      "title": "MechanicalHandoff",
      "type": "object"
    },
    "Terminal": {
      "additionalProperties": false,
      "properties": {
        "exclusive": {
          "title": "Exclusive",
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "instance": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Instance",
          "type": "string"
        },
        "interface_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Id"
        },
        "interface_pin": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Pin"
        },
        "kind": {
          "$ref": "#/$defs/TerminalKind"
        },
        "pin": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Pin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "instance",
        "pin",
        "kind",
        "exclusive"
      ],
      "title": "Terminal",
      "type": "object"
    },
    "TerminalKind": {
      "enum": [
        "electrical",
        "mechanical",
        "logical"
      ],
      "title": "TerminalKind",
      "type": "string"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "exclude"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assemblies": {
      "items": {
        "$ref": "#/$defs/Assembly"
      },
      "title": "Assemblies",
      "type": "array"
    },
    "blocking_issues": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blocking Issues",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/Connection"
      },
      "title": "Connections",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "harnesses": {
      "items": {
        "$ref": "#/$defs/Harness"
      },
      "title": "Harnesses",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Id",
      "type": "string"
    },
    "maturity": {
      "enum": [
        "training",
        "engineering_review",
        "prototype",
        "pilot",
        "production"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "mechanical": {
      "items": {
        "$ref": "#/$defs/MechanicalHandoff"
      },
      "title": "Mechanical",
      "type": "array"
    },
    "revision": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Revision",
      "type": "string"
    },
    "root_assembly": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Root Assembly",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "terminals": {
      "items": {
        "$ref": "#/$defs/Terminal"
      },
      "title": "Terminals",
      "type": "array"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/Variant"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "maturity",
    "root_assembly",
    "assemblies",
    "terminals",
    "connections",
    "variants",
    "evidence",
    "harnesses",
    "mechanical",
    "blocking_issues"
  ],
  "title": "ProductRecord",
  "type": "object"
}
