{
  "$defs": {
    "ComponentContract": {
      "additionalProperties": false,
      "properties": {
        "footprint": {
          "minLength": 1,
          "title": "Footprint",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "footprint"
      ],
      "title": "ComponentContract",
      "type": "object"
    },
    "HarnessInterfaceValidationContract": {
      "additionalProperties": false,
      "description": "Trace a harness-interface sheet to only its owned electrical conductors.",
      "properties": {
        "connection_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Connection Ids",
          "type": "array"
        },
        "expected_ignored_checks": {
          "$ref": "#/$defs/IgnoredChecks"
        },
        "harness_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Harness Ids",
          "type": "array"
        },
        "kind": {
          "const": "harness_interface",
          "title": "Kind",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "terminal_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Terminal Ids",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "connection_ids",
        "terminal_ids",
        "harness_ids",
        "expected_ignored_checks",
        "kind"
      ],
      "title": "HarnessInterfaceValidationContract",
      "type": "object"
    },
    "IgnoredChecks": {
      "additionalProperties": false,
      "properties": {
        "drc": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Drc",
          "type": "array"
        },
        "erc": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Erc",
          "type": "array"
        }
      },
      "required": [
        "erc",
        "drc"
      ],
      "title": "IgnoredChecks",
      "type": "object"
    },
    "PcbValidationContract": {
      "additionalProperties": false,
      "description": "Native checks and independent electrical contract for a board deliverable.",
      "properties": {
        "components": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]*$": {
              "$ref": "#/$defs/ComponentContract"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Components",
          "type": "object"
        },
        "expected_ignored_checks": {
          "$ref": "#/$defs/IgnoredChecks"
        },
        "kind": {
          "const": "pcb",
          "title": "Kind",
          "type": "string"
        },
        "nets": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]*$": {
              "items": {
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Nets",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "components",
        "nets",
        "expected_ignored_checks"
      ],
      "title": "PcbValidationContract",
      "type": "object"
    },
    "ProjectKind": {
      "description": "The engineering deliverable represented by one native KiCad project.",
      "enum": [
        "pcb",
        "schematic",
        "system_wiring",
        "harness_interface"
      ],
      "title": "ProjectKind",
      "type": "string"
    },
    "SchematicValidationContract": {
      "additionalProperties": false,
      "description": "Native checks for a schematic-only deliverable with no manufactured PCB.",
      "properties": {
        "expected_ignored_checks": {
          "$ref": "#/$defs/IgnoredChecks"
        },
        "kind": {
          "const": "schematic",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expected_ignored_checks"
      ],
      "title": "SchematicValidationContract",
      "type": "object"
    },
    "SystemWiringValidationContract": {
      "additionalProperties": false,
      "description": "Trace a whole-system KiCad view to every typed product relationship.",
      "properties": {
        "connection_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Connection Ids",
          "type": "array"
        },
        "expected_ignored_checks": {
          "$ref": "#/$defs/IgnoredChecks"
        },
        "harness_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Harness Ids",
          "type": "array"
        },
        "kind": {
          "const": "system_wiring",
          "title": "Kind",
          "type": "string"
        },
        "mechanical_handoff_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Mechanical Handoff Ids",
          "type": "array"
        },
        "product_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "terminal_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Terminal Ids",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "connection_ids",
        "terminal_ids",
        "harness_ids",
        "expected_ignored_checks",
        "kind",
        "mechanical_handoff_ids"
      ],
      "title": "SystemWiringValidationContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assurance_profile": {
      "enum": [
        "training",
        "production"
      ],
      "title": "Assurance Profile",
      "type": "string"
    },
    "image": {
      "minLength": 1,
      "title": "Image",
      "type": "string"
    },
    "kicad_version": {
      "minLength": 1,
      "title": "Kicad Version",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ProjectKind"
    },
    "not_for_manufacture": {
      "title": "Not For Manufacture",
      "type": "boolean"
    },
    "project": {
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "required_inputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Inputs",
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "source_roots": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Roots",
      "type": "array"
    },
    "toolchain_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Toolchain Id",
      "type": "string"
    },
    "validation": {
      "discriminator": {
        "mapping": {
          "harness_interface": "#/$defs/HarnessInterfaceValidationContract",
          "pcb": "#/$defs/PcbValidationContract",
          "schematic": "#/$defs/SchematicValidationContract",
          "system_wiring": "#/$defs/SystemWiringValidationContract"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PcbValidationContract"
        },
        {
          "$ref": "#/$defs/SchematicValidationContract"
        },
        {
          "$ref": "#/$defs/SystemWiringValidationContract"
        },
        {
          "$ref": "#/$defs/HarnessInterfaceValidationContract"
        }
      ],
      "title": "Validation"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "assurance_profile",
    "not_for_manufacture",
    "project_id",
    "toolchain_id",
    "kicad_version",
    "image",
    "project",
    "source_roots",
    "required_inputs",
    "validation"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
