{
  "$defs": {
    "DeviationStatus": {
      "enum": [
        "open",
        "approved",
        "closed"
      ],
      "title": "DeviationStatus",
      "type": "string"
    },
    "ReleaseApproval": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "format": "date",
          "title": "Approved At",
          "type": "string"
        },
        "electrical_reviewer": {
          "minLength": 1,
          "title": "Electrical Reviewer",
          "type": "string"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "integrator": {
          "minLength": 1,
          "title": "Integrator",
          "type": "string"
        },
        "mechanical_reviewer": {
          "minLength": 1,
          "title": "Mechanical Reviewer",
          "type": "string"
        }
      },
      "required": [
        "electrical_reviewer",
        "mechanical_reviewer",
        "integrator",
        "approved_at",
        "evidence"
      ],
      "title": "ReleaseApproval",
      "type": "object"
    },
    "ReleaseArtifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "intended_use": {
          "minLength": 1,
          "title": "Intended Use",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReleaseArtifactKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "intended_use"
      ],
      "title": "ReleaseArtifact",
      "type": "object"
    },
    "ReleaseArtifactKind": {
      "enum": [
        "review_record",
        "bom",
        "schematic_export",
        "pcb_export",
        "harness_export",
        "validation_report",
        "fabrication_package",
        "assembly_package"
      ],
      "title": "ReleaseArtifactKind",
      "type": "string"
    },
    "ReleaseClass": {
      "enum": [
        "engineering_review",
        "prototype",
        "pilot",
        "production"
      ],
      "title": "ReleaseClass",
      "type": "string"
    },
    "ReleaseDeviation": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "expires": {
          "format": "date",
          "title": "Expires",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "scope": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/DeviationStatus"
        }
      },
      "required": [
        "id",
        "scope",
        "owner",
        "reason",
        "status",
        "expires",
        "evidence"
      ],
      "title": "ReleaseDeviation",
      "type": "object"
    },
    "ReleaseInterface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "ReleaseInterface",
      "type": "object"
    },
    "ReleaseLibrary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "licensing_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Licensing Sha256",
          "type": "string"
        },
        "provenance_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provenance Sha256",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "provenance_sha256",
        "licensing_sha256"
      ],
      "title": "ReleaseLibrary",
      "type": "object"
    },
    "ReleaseStatus": {
      "enum": [
        "candidate",
        "approved"
      ],
      "title": "ReleaseStatus",
      "type": "string"
    },
    "ReleaseVariant": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Product",
          "type": "string"
        },
        "product_revision": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Product Revision",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Variant",
          "type": "string"
        },
        "variant_revision": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Variant Revision",
          "type": "string"
        }
      },
      "required": [
        "product",
        "product_revision",
        "variant",
        "variant_revision"
      ],
      "title": "ReleaseVariant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ReleaseArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "checks": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]*$": {
          "enum": [
            "PASS",
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Checks",
      "type": "object"
    },
    "deviations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReleaseDeviation"
      },
      "title": "Deviations",
      "type": "array"
    },
    "interfaces": {
      "items": {
        "$ref": "#/$defs/ReleaseInterface"
      },
      "title": "Interfaces",
      "type": "array"
    },
    "libraries": {
      "items": {
        "$ref": "#/$defs/ReleaseLibrary"
      },
      "title": "Libraries",
      "type": "array"
    },
    "release_class": {
      "$ref": "#/$defs/ReleaseClass"
    },
    "release_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_tag": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Tag"
    },
    "status": {
      "$ref": "#/$defs/ReleaseStatus"
    },
    "toolchain_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Toolchain Id",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/ReleaseVariant"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "release_id",
    "release_class",
    "status",
    "source_commit",
    "toolchain_id",
    "variants",
    "libraries",
    "interfaces",
    "checks",
    "artifacts"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
