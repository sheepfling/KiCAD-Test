{
  "additionalProperties": false,
  "description": "Versioned, portable inventory for a repository template implementation.",
  "properties": {
    "adoption_guide": {
      "minLength": 1,
      "title": "Adoption Guide",
      "type": "string"
    },
    "required_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Paths",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "template_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Template Version",
      "type": "string"
    },
    "upgrades_catalog": {
      "minLength": 1,
      "title": "Upgrades Catalog",
      "type": "string"
    }
  },
  "required": [
    "template_version",
    "required_paths",
    "adoption_guide",
    "upgrades_catalog"
  ],
  "title": "TemplateContract",
  "type": "object"
}
