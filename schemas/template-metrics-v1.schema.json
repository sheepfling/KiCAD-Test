{
  "$defs": {
    "CheckMetric": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "minimum": 0,
          "title": "Findings",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "findings"
      ],
      "title": "CheckMetric",
      "type": "object"
    },
    "DeviationMetrics": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "minimum": 0,
          "title": "Approved",
          "type": "integer"
        },
        "closed": {
          "minimum": 0,
          "title": "Closed",
          "type": "integer"
        },
        "expired": {
          "minimum": 0,
          "title": "Expired",
          "type": "integer"
        },
        "open": {
          "minimum": 0,
          "title": "Open",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "approved",
        "open",
        "closed",
        "expired"
      ],
      "title": "DeviationMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build_authorized": {
      "const": false,
      "default": false,
      "title": "Build Authorized",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckMetric"
      },
      "title": "Checks",
      "type": "array"
    },
    "deviations": {
      "$ref": "#/$defs/DeviationMetrics"
    },
    "lane": {
      "const": "TEMPLATE_METRICS",
      "default": "TEMPLATE_METRICS",
      "title": "Lane",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "stale_evidence": {
      "minimum": 0,
      "title": "Stale Evidence",
      "type": "integer"
    }
  },
  "required": [
    "checks",
    "stale_evidence",
    "deviations"
  ],
  "title": "TemplateMetricsReport",
  "type": "object"
}
